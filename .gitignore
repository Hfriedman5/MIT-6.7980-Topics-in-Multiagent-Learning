# Only the public course source directories belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/Makefile
!/html-export.json
!/content/
!/syllabus/
!/html-exporter/
!/scripts/
!/website/
!/docs/
!/slides/
!/.vscode/
# Publish configured course slide PDFs, while keeping editable decks private.
/slides/*
!/slides/L00_course_intro.pdf

# Build products, editor state, and local secrets.
**/target/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.env
**/.env.*
**/*~
**/.ipynb_checkpoints/
content/.*-check/
content/*.pdf
syllabus/macros.pdf

# Private migration records stay in the local workspace.
/docs/migration/
/migration/

# Local MIT locker deployment tooling and notes.
/deploy/
